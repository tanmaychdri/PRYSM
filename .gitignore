# ── Old / scratch ─────────────────────────────────────────────────────────────
PRISM/
ignored/

# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Distribution / packaging ──────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/
wheels/

# ── Virtual environments ──────────────────────────────────────────────────────
.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# ── Secrets / config ──────────────────────────────────────────────────────────
