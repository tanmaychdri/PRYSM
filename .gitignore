*.bin
*.gguf
*.safetensors

# ── Audio / media ─────────────────────────────────────────────────────────────
*.wav
*.mp3
*.mp4
*.ogg
*.flac

# ── Data / cache (personal memory — never commit) ─────────────────────────────
data/
*.db
*.sqlite
*.sqlite3

# ── Faster-Whisper / Hugging Face model cache ─────────────────────────────────
.cache/
huggingface/

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

