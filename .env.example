# LLM (OpenAI-compatible)
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1

# ElevenLabs TTS
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# STT (FasterWhisper)
STT_MODEL=base
STT_DEVICE=cpu
STT_LANGUAGE=en

# Wake word
WAKEWORD_PHRASE=hey prysm

# Audio
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_MS=30
